    "ap_polls.head()\n",
    "#only getting last ap poll of the seasson\n",
    "ap = ap_polls[ap_polls[\"YEAR\"] <= 2024].copy()\n",
    "\n",
    "ap = ap.sort_values(\"WEEK\")\n",
    "\n",
    "ap = ap.groupby([\"YEAR\", \"TEAM\"],as_index=False).last()\n",
    "\n",
    "ap = ap[[\"YEAR\", \"TEAM\", \"AP_VOTES\", \"AP_RANK\"]]\n",
    "ap.head()"
   ]
